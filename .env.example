# Spoke-Grid configuration. Copy to .env and adjust.

PORT=3000

# Furthest a hub may be from a pickup or drop point, in kilometres.
MAX_SPOKE_RADIUS_KM=200

# Capacity (parcels in flight) for hubs that do not define their own.
HUB_CAPACITY_DEFAULT=120

# Milliseconds between hub health probes.
UPTIME_PROBE_INTERVAL_MS=30000

# Hub and spoke definitions, relative to the project root.
NODES_FILE=data/sample_nodes.json

# ONDC identity used in response contexts.
ONDC_SUBSCRIBER_ID=spoke-grid.example.com
ONDC_BPP_URI=http://localhost:3000/ondc
ONDC_DOMAIN=ONDC:LOG10
